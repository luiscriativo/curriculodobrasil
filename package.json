{
  "name": "curriculodobrasil",
  "productName": "CurriculoDoBrasil",
  "version": "1.0.0",
  "description": "Crie e edite currículos bonitos com dezenas de modelos e exporte PDF com texto real, pronto para os sistemas de RH (ATS).",
  "main": "src/main/main.js",
  "author": {
    "name": "luiscriativo",
    "email": "luiscriativo@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/luiscriativo/curriculodobrasil",
  "repository": {
    "type": "git",
    "url": "https://github.com/luiscriativo/curriculodobrasil.git"
  },
  "scripts": {
    "start": "vite build && electron .",
    "dev": "vite build && electron .",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && node scripts/check.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "icons": "node scripts/make-icons.mjs",
    "demo": "node scripts/make-demo-data.mjs",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "vite build && electron-builder --mac dmg --publish never",
    "dist:linux": "vite build && electron-builder --linux AppImage deb rpm --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/josefin-sans": "^5.3.0",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
